# ── AI Service URL ──────────────────────────────────
# In local dev: http://localhost:8000
# In production on Vercel: URL to your deployed FastAPI AI service (e.g., on Render)
# Example: https://sourcefinch-ai-service.onrender.com
VITE_AI_SERVICE_URL=http://localhost:8000

# ── Backend URL (Optional) ───────────────────────────
# In local dev or when using Vercel rewrites, leave this empty.
# In production, if you want direct API calls instead of Vercel rewrites:
# Example: https://sourcefintch.onrender.com
VITE_BACKEND_URL=

# ── Clerk Authentication ─────────────────────────────
# Publishable key from your Clerk dashboard (https://dashboard.clerk.com).
# MUST come from the same Clerk application as the backend CLERK_SECRET_KEY
# in backend/.env — mismatched keys silently 401.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me