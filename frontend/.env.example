# ── AI Service URL ──────────────────────────────────
# The frontend calls the AI service directly (not through the Node proxy)
# because it's a separate service. VITE_ prefix is required for Vite to
# expose env vars to the browser.
VITE_AI_SERVICE_URL=http://localhost:8000

# ── Clerk ─────────────────────────────────────────────
# Publishable key from your Clerk dashboard (https://dashboard.clerk.com).
# MUST come from the same Clerk application as the backend CLERK_SECRET_KEY
# in backend/.env — mismatched keys silently 401.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me