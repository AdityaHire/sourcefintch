# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────
# Frontend origin allowed to make requests (Vite default dev port)
CORS_ORIGIN=http://localhost:5173

# ── MySQL ───────────────────────────────────────────
# Aiven cloud MySQL — update these for your deployment
MYSQL_HOST=mysql-609d784-adityahire08-ab89.j.aivencloud.com
MYSQL_PORT=24225
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password
MYSQL_DATABASE=sourcefinch
# Set to "true" for cloud MySQL providers (Aiven, PlanetScale, etc.)
MYSQL_SSL=true

# ── GitHub ──────────────────────────────────────────
# Personal access token for higher API rate limits (optional for public repos)
GITHUB_TOKEN=

# ── Ingestion limits ───────────────────────────────
# Maximum repository size in KB before cloning is rejected (~50MB default).
# Note: MAX_REPO_SIZE_KB is checked against GitHub's reported repo size (full history), not shallow-clone size.
MAX_REPO_SIZE_KB=50000
# Maximum individual file size in bytes (1MB default)
MAX_FILE_SIZE_BYTES=1048576
# Clone timeout in milliseconds (2 minutes default)
CLONE_TIMEOUT_MS=120000

# ── AI Service ─────────────────────────────────────
# URL of the Python AI service (for triggering code parsing after ingestion)
AI_SERVICE_URL=http://localhost:8000

# ── Clerk Authentication ──────────────────────────
# Both keys come from the SAME Clerk application at https://dashboard.clerk.com
# Enable Google + GitHub as social sign-in providers in the Clerk dashboard.
# Mismatched keys from different Clerk apps cause silent 401s.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── Internal API Secret ────────────────────────────
# Shared secret for server-to-server calls from the AI service.
# Must match INTERNAL_API_SECRET in ai-service/.env (same value).
# If unset or empty, internal-auth checks fail closed (401).
INTERNAL_API_SECRET=replace_with_long_random_string
