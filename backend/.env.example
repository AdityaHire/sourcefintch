# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────
# Frontend origin allowed to make requests (Vite default dev port)
CORS_ORIGIN=http://localhost:5173

# ── MySQL ───────────────────────────────────────────
# Aiven cloud MySQL — update these for your deployment
MYSQL_HOST=mysql-609d784-adityahire08-ab89.j.aivencloud.com
MYSQL_PORT=24225
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password
MYSQL_DATABASE=sourcefinch
# Set to "true" for cloud MySQL providers (Aiven, PlanetScale, etc.)
MYSQL_SSL=true

# ── GitHub ──────────────────────────────────────────
# Personal access token for higher API rate limits (optional for public repos)
GITHUB_TOKEN=

# ── Ingestion limits ───────────────────────────────
# Maximum repository size in KB before cloning is rejected (~50MB default)
MAX_REPO_SIZE_KB=50000
# Maximum individual file size in bytes (1MB default)
MAX_FILE_SIZE_BYTES=1048576
# Clone timeout in milliseconds (2 minutes default)
CLONE_TIMEOUT_MS=120000
