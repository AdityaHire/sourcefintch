# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────
# Frontend origin allowed to make requests (Vite default dev port)
CORS_ORIGIN=http://localhost:5173

# ── MySQL ───────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=sourcefinch
# Set to "true" for cloud MySQL providers (Aiven, PlanetScale, etc.)
MYSQL_SSL=false

