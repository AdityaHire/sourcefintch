# ── Server ──────────────────────────────────────────
PORT=8000

# ── LLM Provider ───────────────────────────────────
# Options: groq, gemini, ollama
# groq and gemini have free tiers; ollama runs 100% locally.
LLM_PROVIDER=groq

# Required only if LLM_PROVIDER is groq or gemini:
# LLM_API_KEY=your-api-key-here

# ── Embedding Provider ─────────────────────────────
# Options: sentence-transformers (local, no key needed), openai
EMBEDDING_PROVIDER=sentence-transformers

# Required only if EMBEDDING_PROVIDER is openai:
# EMBEDDING_API_KEY=your-api-key-here

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
