# ── Server ──────────────────────────────────────────
PORT=8000

# ── LLM Provider ───────────────────────────────────
# Options: groq, ollama
LLM_PROVIDER=groq
# Get a free key at https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# ── RAG Parameters ──────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SCORE=0.20
RAG_MAX_CONTEXT_CHARS=12000

# ── Embedding Provider ─────────────────────────────
# Options: local (sentence-transformers, ₹0 cost), gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Required only if EMBEDDING_PROVIDER is openai:
# EMBEDDING_API_KEY=your-api-key-here

# Required only if EMBEDDING_PROVIDER is gemini:
# Get a free key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini embedding model (text-embedding-004 is deprecated Jan 2026)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MRL truncation target (native Gemini dim is 3072). Use 768 or 1536 to keep
# vectors compact. Vectors from different providers live in separate Qdrant
# collections, so do NOT change this after ingesting a repo without re-indexing.
GEMINI_EMBEDDING_DIMENSION=768

# ── Qdrant Vector DB ────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=sourcefinch_chunks
# QDRANT_API_KEY=your-qdrant-api-key-if-cloud

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Node API ────────────────────────────────────────
# URL of the Node backend (for fetching file lists and repo status)
NODE_API_URL=http://localhost:3001

# ── Clone settings ──────────────────────────────────
CLONE_TIMEOUT_SECONDS=120
