# ── Server ──────────────────────────────────────────
PORT=8000

# ── LLM Provider ───────────────────────────────────
# Options: groq, ollama
LLM_PROVIDER=groq
# Get a free key at https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30

# ── RAG Parameters ──────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
RAG_MAX_CONTEXT_CHARS=12000

# ── Embedding Provider ─────────────────────────────
# Options: local (sentence-transformers, ₹0 cost), openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Required only if EMBEDDING_PROVIDER is openai:
# EMBEDDING_API_KEY=your-api-key-here

# ── Qdrant Vector DB ────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=sourcefinch_chunks
# QDRANT_API_KEY=your-qdrant-api-key-if-cloud

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Node API ────────────────────────────────────────
# URL of the Node backend (for fetching file lists and repo status)
NODE_API_URL=http://localhost:3001

# ── Clone settings ──────────────────────────────────
CLONE_TIMEOUT_SECONDS=120
